# ─────────────────────────────────────────────
# MirhalGo — environment variables (section 8.6)
# Copy to frontend/.env and backend/.env and fill in.
# NEVER commit real values.
# ─────────────────────────────────────────────

# ---------- web (frontend/.env) ----------
VITE_SUPABASE_URL=https://wpcpxmwkihaismxbdxip.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000
# MW_002: customer portal data from MSW mocks (true on the preview until the real API exists)
VITE_USE_MOCKS=true
# MW_002: false hides company names in the directory (offers are always anonymous)
VITE_SHOW_COMPANY_IDENTITY=true
# MW_004: company portal demo tools (Reset demo data, suspension switch) on a staging / preview
# build. Always on in development; leave empty (off) for production.
VITE_DEMO_TOOLS=

# ---------- api (backend/.env) ----------
PORT=4000
SUPABASE_URL=https://wpcpxmwkihaismxbdxip.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mirhalgov1@gmail.com
SMTP_PASS=
CONTACT_TO=mirhalgov1@gmail.com
OTP_PEPPER=
CORS_ORIGINS=http://localhost:5173
# MW_004: demo company seed (npm run seed:demo-company -w backend). Development / staging only.
# The password is shared privately with the team: NEVER commit it. Leave empty here.
DEMO_COMPANY_PASSWORD=
# Optional overrides (defaults: demo.company@mirhalgo.com, +201000000001, CR 9990000001, tax 999000001)
DEMO_COMPANY_EMAIL=
DEMO_COMPANY_PHONE=
DEMO_COMPANY_CR=
DEMO_COMPANY_TAX=
