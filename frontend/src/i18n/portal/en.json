    "faq": {
      "requests": {
        "0": {
          "q": "How does a shipping request work?",
          "a": "Choose a service, describe your shipment and send. Verified companies send you offers, you compare them and choose one."
        },
        "1": {
          "q": "Can I send a request to specific companies?",
          "a": "Yes. In Companies, select up to 10 companies and choose \"Send request to selected\"."
        }
      },
      "attempts": {
        "0": {
          "q": "What are requests (attempts)?",
          "a": "You can send 5 requests per month. Each request uses one, even if it goes to several companies."
        },
        "1": {
          "q": "Do I get a request back if I cancel?",
          "a": "Yes, if you cancel before any offer arrives."
        }
      },
      "offers": {
        "0": {
          "q": "Why are offers anonymous?",
          "a": "So you compare offers only on price and service. The company is revealed after final approval."
        },
        "1": {
          "q": "Is accepting an offer final?",
          "a": "No. Your selection is preliminary until our team gives the final approval."
        }
      },
      "payments": {
        "0": {
          "q": "How do I pay?",
          "a": "You pay the company directly as agreed in the offer. MirhalGo doesn't charge customers."
        },
        "1": {
          "q": "Are there hidden fees?",
          "a": "No. The offer shows the total cost and what it includes."
        }
      },
      "cancellation": {
        "0": {
          "q": "How do I cancel a request?",
          "a": "Open the order, then Details › Cancel request. You can cancel until an offer is approved."
        },
        "1": {
          "q": "Can a company cancel?",
          "a": "If a company can't continue, our team helps you choose another offer."
        }
      }
    },
